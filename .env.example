# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payment_platform

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin@localhost:5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# HMAC
HMAC_SECRET=your-hmac-secret-key-change-this-in-production
# When true, requests carrying an X-Signature header must pass HMAC verification.
# Requests without the header are unaffected (lets JWT-based dashboard traffic through).
HMAC_VERIFICATION_ENABLED=false

# API Keys
API_KEY_ENCRYPTION_KEY=your-32-character-encryption-key

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=http://localhost:3000
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Mock Payment Gateway
MOCK_GATEWAY_SUCCESS_RATE=0.95
MOCK_GATEWAY_LATENCY_MS=100
